#!/bin/sh
# Bootstrap launcher; regenerate with `./gradlew wrapper --gradle-version 8.13`.
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" $JAVA_OPTS -Dorg.gradle.appname=gradlew \
  -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
