# Constrained decoding for the on-device parser (PROJECT_SPEC §10.3, §15.6).
# Exactly the canonical training target (kharcha_ml.finetune.train.target_json):
# fixed key order, compact, nulls kept. android-app/app/src/main/assets/parser.gbnf is a copy.
root ::= negative | positive
negative ::= "{\"isTransaction\":false}"
positive ::= "{\"isTransaction\":true,\"amount\":" str ",\"direction\":" direction ",\"channel\":" channel ",\"status\":" status ",\"merchantRaw\":" strnull ",\"counterpartyVpa\":" strnull ",\"referenceId\":" strnull ",\"accountHint\":" strnull ",\"balanceAfter\":" strnull ",\"promisedRefundDays\":" intnull "}"
direction ::= "\"DEBIT\"" | "\"CREDIT\""
channel ::= "\"UPI\"" | "\"CARD\"" | "\"ATM\"" | "\"NETBANKING\"" | "\"WALLET\"" | "\"CASH\"" | "\"UNKNOWN\""
status ::= "\"SUCCESS\"" | "\"FAILED\"" | "\"PENDING\"" | "\"REVERSED\"" | "\"REFUND_INITIATED\""
strnull ::= str | "null"
intnull ::= [0-9] [0-9]? | "null"
str ::= "\"" char* "\""
char ::= [^"\\\x00-\x1f] | "\\" ["\\/bfnrt]
